-- Raycast Visibility (Wall Check)
local function IsVisible(part)
    local origin = Cam.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {P.Character, Cam}
    params.IgnoreWater = true
    local result = workspace:Raycast(origin, part.Position - origin, params)
    return result and result.Instance:IsDescendantOf(part.Parent) or false
end

-- MAIN AIMBOT LOOP (FOV CIRCLE VS 360 MODE)
RS.RenderStepped:Connect(function()
    if S.Aimbot then
        local tgt = nil
        local myChar = P.Character
        local camPos = Cam.CFrame.Position
        
        if S.FOV then
            -- Mode 1: FOV CIRCLE ON (Strict Circle Area & On-Screen Only)
            local minDist, center = S.Rad, Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
            for _, p in pairs(game:GetService("Players"):GetPlayers()) do
                if p ~= P and p.Name ~= P.Name and p.Character and p.Character ~= myChar and p.Character:FindFirstChild(S.Part) and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    if not (S.Team and p.Team == P.Team) then
                        local part = p.Character[S.Part]
                        local pos, onScr = Cam:WorldToViewportPoint(part.Position)
                        if onScr then
                            local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if d < minDist then
                                if not S.WallCheck or IsVisible(part) then
                                    minDist, tgt = d, part
                                end
                            end
                        end
                    end
                end
            end
        else
            -- Mode 2: FOV CIRCLE OFF (Full 360 Degree Detection Anywhere Around You)
            local minDist3D = math.huge
            for _, p in pairs(game:GetService("Players"):GetPlayers()) do
                if p ~= P and p.Name ~= P.Name and p.Character and p.Character ~= myChar and p.Character:FindFirstChild(S.Part) and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    if not (S.Team and p.Team == P.Team) then
                        local part = p.Character[S.Part]
                        local d3D = (part.Position - camPos).Magnitude
                        if d3D < minDist3D then
                            if not S.WallCheck or IsVisible(part) then
                                minDist3D, tgt = d3D, part
                            end
                        end
                    end
                end
            end
        end
        
        -- INSTANT SNAP LOCK TO HEAD / TORSO
        if tgt then
            Cam.CFrame = CFrame.lookAt(Cam.CFrame.Position, tgt.Position)
        end
    end
end)
