local function Toggle(txt, def, cb)
    local st = def
    local btn = c("TextButton", {Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = st and Color3.fromRGB(0, 180, 140) or Color3.fromRGB(35, 38, 48), Text = txt .. ": " .. (st and "ON" or "OFF"), TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamMedium, TextSize = 13, Parent = Content})
    corner(btn, 8)
    btn.MouseButton1Click:Connect(function() st = not st; btn.BackgroundColor3 = st and Color3.fromRGB(0, 180, 140) or Color3.fromRGB(35, 38, 48); btn.Text = txt .. ": " .. (st and "ON" or "OFF"); cb(st) end)
end

local function Adjuster(txt, val, step, min, max, cb)
    local f = c("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Color3.fromRGB(30, 33, 42), Parent = Content}); corner(f, 8)
    local l = c("TextLabel", {Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0, 10, 0, 0), Text = txt .. ": " .. val, TextColor3 = Color3.fromRGB(220, 220, 220), Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, Parent = f})
    local function b(t, x, off)
        local btn = c("TextButton", {Size = UDim2.new(0, 30, 0, 28), Position = UDim2.new(1, x, 0, 6), BackgroundColor3 = Color3.fromRGB(45, 48, 60), Text = t, TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, Parent = f}); corner(btn, 6)
        btn.MouseButton1Click:Connect(function() val = math.clamp(math.floor((val + off) * 100) / 100, min, max); l.Text = txt .. ": " .. val; cb(val) end)
    end
    b("-", -70, -step); b("+", -35, step)
end

