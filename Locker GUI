-- 8. Logic & Connections
local selectedTarget = nil
local isSticking = false
local loopConnection = nil
local savedPosition = nil -- Yahan purani position save hogi

local function populatePlayers()
    for _, child in pairs(ScrollFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local count = 0
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            count = count + 1
            local pButton = Instance.new("TextButton")
            pButton.Size = UDim2.new(1, -5, 0, 25)
            pButton.BackgroundColor3 = Color3.fromRGB(70, 70, 75)
            pButton.Text = player.Name
            pButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            pButton.TextStrokeTransparency = 0
            pButton.Font = Enum.Font.FredokaOne
            pButton.TextSize = 14
            pButton.Parent = ScrollFrame
            
            Instance.new("UICorner", pButton).CornerRadius = UDim.new(0, 4)
            local pStroke = Instance.new("UIStroke", pButton)
            pStroke.Thickness = 1
            pStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            
            pButton.MouseButton1Click:Connect(function()
                selectedTarget = player
                TargetLabel.Text = "Target: " .. player.Name
            end)
        end
    end
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 29)
end

local function stopSticking()
    isSticking = false
    if loopConnection then
        loopConnection:Disconnect()
        loopConnection = nil
    end
    
    -- Agar pehle ki position save hai, toh character ko waha teleport kar do
    if savedPosition then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myChar.HumanoidRootPart.CFrame = savedPosition
        end
        savedPosition = nil -- Reset kar do
    end
end

local function startSticking()
    if not selectedTarget then return end
    
    local myChar = LocalPlayer.Character
    -- Stick start karne se theek pehle current position ko save kar lena
    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
        savedPosition = myChar.HumanoidRootPart.CFrame
    end
    
    isSticking = true
    if loopConnection then loopConnection:Disconnect() end
    
    loopConnection = RunService.RenderStepped:Connect(function()
        if not isSticking or not selectedTarget then
            stopSticking()
            return
        end
        
        local targetChar = selectedTarget.Character
        myChar = LocalPlayer.Character -- Update char in case of respawn
        
        if targetChar and myChar and targetChar:FindFirstChild("HumanoidRootPart") and myChar:FindFirstChild("HumanoidRootPart") then
            local targetHRP = targetChar.HumanoidRootPart
            local myHRP = myChar.HumanoidRootPart
            
            local offsetCFrame = targetHRP.CFrame * CFrame.new(0, 0, 3) 
            myHRP.CFrame = CFrame.lookAt(offsetCFrame.Position, targetHRP.Position)
        else
            stopSticking()
        end
    end)
end

