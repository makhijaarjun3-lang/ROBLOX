        for p, b in pairs(playerButtons) do tw(b, {BackgroundColor3 = BG_LIGHT}, 0.2); local s = b:FindFirstChildOfClass("UIStroke"); if s then s.Color = (p.Name == OWNER_NAME) and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(45, 50, 65) end end
