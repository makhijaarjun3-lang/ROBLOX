-- 🛠 UI Helpers
local function tw(obj, props, time, style)
    TS:Create(obj, TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props):Play()
end
local function c(cls, props)
    local i = Instance.new(cls); for k, v in pairs(props) do i[k] = v end; return i
end
local function corner(p, r) c("UICorner", {CornerRadius = UDim.new(0, r or 8), Parent = p}) end
local function stroke(p, col, thick) c("UIStroke", {Color = col or Color3.fromRGB(40, 45, 60), Thickness = thick or 1, Parent = p}) end
local function gradient(p, c1, c2, rot) c("UIGradient", {Color = ColorSequence.new{ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(1, c2)}, Rotation = rot or 0, Parent = p}) end

