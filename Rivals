    corner(btn, 8); local strk = c("UIStroke", {Color = isOwner and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(45, 50, 65), Thickness = 1, Parent = btn})
    btn.MouseButton1Click:Connect(function() 
        SelectedPlayer = plr; StatusLbl.Text = IsStuck and ("🔒 LOCKED: " .. plr.DisplayName) or ("Target: " .. plr.DisplayName)
