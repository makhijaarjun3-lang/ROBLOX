local function Notify(title, msg, color)
    local wrapper = c("Frame", {Size = UDim2.new(1, 0, 0, 65), BackgroundTransparency = 1, Parent = NotifContainer})
    local notif = c("Frame", {Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(-1.5, 0, 0, 0), BackgroundColor3 = BG_DARK, Parent = wrapper})
    corner(notif, 12); stroke(notif, Color3.fromRGB(45, 50, 65), 1.5)
    
    local accent = c("Frame", {Size = UDim2.new(0, 5, 1, 0), BackgroundColor3 = color or ACCENT, Parent = notif}); corner(accent, 12)
    gradient(accent, color or ACCENT, ACCENT_GLOW, 90)
    
    c("TextLabel", {Size = UDim2.new(1, -24, 0, 20), Position = UDim2.new(0, 16, 0, 10), Text = title, TextColor3 = color or ACCENT, Font = Enum.Font.GothamBlack, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, Parent = notif})
    c("TextLabel", {Size = UDim2.new(1, -24, 0, 20), Position = UDim2.new(0, 16, 0, 32), Text = msg, TextColor3 = TEXT_SUB, Font = Enum.Font.GothamMedium, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, Parent = notif})
    
    tw(notif, {Position = UDim2.new(0, 0, 0, 0)}, 0.5, Enum.EasingStyle.Bounce)
    task.delay(3.5, function()
        tw(notif, {Position = UDim2.new(-1.5, 0, 0, 0)}, 0.4, Enum.EasingStyle.Back)
        task.wait(0.4); wrapper:Destroy()
    end)
end

