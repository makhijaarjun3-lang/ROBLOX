local function MakeToggle(txt, def, infoText, cb)
    local st = def; local order = O()
    local btn = c("TextButton", {Size = UDim2.new(1, 0, 0, 42), LayoutOrder = order, BackgroundColor3 = BG_LIGHT, Text = "", AutoButtonColor = false, Parent = Content}); corner(btn, 10); stroke(btn, Color3.fromRGB(45, 50, 65))
    c("TextLabel", {Size = UDim2.new(0.65, 0, 1, 0), Position = UDim2.new(0, 14, 0, 0), Text = txt, TextColor3 = TEXT_MAIN, Font = Enum.Font.GothamSemibold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, Parent = btn})
    local track = c("Frame", {Size = UDim2.new(0, 42, 0, 22), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), BackgroundColor3 = st and ACCENT or Color3.fromRGB(40, 44, 55), Parent = btn}); corner(track, 12)
    local knob = c("Frame", {Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, st and 22 or 2, 0.5, -9), BackgroundColor3 = Color3.fromRGB(255, 255, 255), Parent = track}); corner(knob, 9)
    local knobShad = c("Frame", {Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, 1), BackgroundColor3 = Color3.fromRGB(0,0,0), BackgroundTransparency = 0.8, ZIndex = knob.ZIndex - 1, Parent = knob}); corner(knobShad, 9)
    if infoText then AttachInfo(btn, infoText, order + 1, UDim2.new(1, -62, 0.5, 0)) end
    btn.MouseButton1Click:Connect(function() 
        st = not st; tw(track, {BackgroundColor3 = st and ACCENT or Color3.fromRGB(40, 44, 55)}, 0.25)
        tw(knob, {Position = UDim2.new(0, st and 22 or 2, 0.5, -9)}, 0.25, Enum.EasingStyle.Back); cb(st) 
    end)
end

local function MakeTextbox(txt, def, minVal, maxVal, infoText, cb)
    local order = O()
    local f = c("Frame", {Size = UDim2.new(1, 0, 0, 42), LayoutOrder = order, BackgroundColor3 = BG_LIGHT, Parent = Content}); corner(f, 10); stroke(f, Color3.fromRGB(45, 50, 65))
    c("TextLabel", {Size = UDim2.new(0.55, 0, 1, 0), Position = UDim2.new(0, 14, 0, 0), Text = txt, TextColor3 = TEXT_SUB, Font = Enum.Font.GothamSemibold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, Parent = f})
    local box = c("TextBox", {Size = UDim2.new(0.28, 0, 0, 28), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), BackgroundColor3 = BG_INPUT, Text = tostring(def), TextColor3 = ACCENT_GLOW, Font = Enum.Font.GothamBlack, TextSize = 13, Parent = f})
    corner(box, 6); stroke(box, Color3.fromRGB(65, 70, 85))
    if infoText then AttachInfo(f, infoText, order + 1, UDim2.new(1, -100, 0.5, 0)) end
    box.FocusLost:Connect(function() 
        local num = tonumber(box.Text); if num then num = math.clamp(num, minVal, maxVal); box.Text = tostring(num); cb(num) else box.Text = tostring(def); cb(def) end 
    end)
end

