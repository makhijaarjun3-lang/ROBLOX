local function IsVisible(part)
    local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = {P.Character, Cam}; params.IgnoreWater = true
    local result = workspace:Raycast(Cam.CFrame.Position, part.Position - Cam.CFrame.Position, params)
    return result and result.Instance:IsDescendantOf(part.Parent) or false
end

local function GetClosestAimbotTarget()
    local bestTgt, minDist, center = nil, math.huge, Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= P and p.Character and p.Character:FindFirstChild(S.Part) and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 and not (S.Team and PlayerRoles[p.Name] == "Ally") then
            local part = p.Character[S.Part]
            if (part.Position - Cam.CFrame.Position).Magnitude <= 1500 then
                local pos, onScr = Cam:WorldToViewportPoint(part.Position)
                if onScr then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if (not S.FOV) or (dist <= S.Rad) then if dist < minDist and (not S.WallCheck or IsVisible(part)) then minDist = dist; bestTgt = part end end
                end
            end
        end
    end
    return bestTgt
end

RS.RenderStepped:Connect(function()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= P and plr.Character then
            local hl = ESPFolder:FindFirstChild("ESP_" .. plr.Name)
            if S.ESP then
                if not hl then hl = c("Highlight", {Name = "ESP_" .. plr.Name, FillTransparency = 0.5, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = ESPFolder}) end
                hl.Adornee = plr.Character; hl.FillColor = (PlayerRoles[plr.Name] == "Ally") and Color3.fromRGB(0, 255, 50) or ACCENT
            elseif hl then hl:Destroy() end
        end
    end

    local myChar = P.Character
    local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hum = myChar and myChar:FindFirstChild("Humanoid")

    if S.Fly and hrp and hum and hum.Health > 0 then
        local bv = hrp:FindFirstChild("DeltaFlyBV") or c("BodyVelocity", {Name = "DeltaFlyBV", MaxForce = Vector3.new(9e9, 9e9, 9e9), Parent = hrp})
        local bg = hrp:FindFirstChild("DeltaFlyBG") or c("BodyGyro", {Name = "DeltaFlyBG", MaxTorque = Vector3.new(9e9, 9e9, 9e9), P = 9e4, Parent = hrp})
        hum.PlatformStand = true; local md = hum.MoveDirection
        if md.Magnitude > 0 then
            local fL, fR = Vector3.new(Cam.CFrame.LookVector.X, 0, Cam.CFrame.LookVector.Z).Unit, Vector3.new(Cam.CFrame.RightVector.X, 0, Cam.CFrame.RightVector.Z).Unit
            local finalVel = (Cam.CFrame.LookVector * md:Dot(fL)) + (Cam.CFrame.RightVector * md:Dot(fR))
            bv.Velocity = (finalVel.Magnitude > 0) and finalVel.Unit * S.FlySpeed or Vector3.new(0,0,0)
        else bv.Velocity = Vector3.new(0, 0, 0) end
        bg.CFrame = Cam.CFrame
    else
        if hrp then if hrp:FindFirstChild("DeltaFlyBV") then hrp.DeltaFlyBV:Destroy() end; if hrp:FindFirstChild("DeltaFlyBG") then hrp.DeltaFlyBG:Destroy() end end
        if hum then hum.PlatformStand = false end
        if S.Speed and hrp and hum and hum.Health > 0 then
            hum.WalkSpeed = S.WalkSpeed
            if hum.MoveDirection.Magnitude > 0 then
                local v = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(hum.MoveDirection.X * S.WalkSpeed, v.Y, hum.MoveDirection.Z * S.WalkSpeed)
            end
        end
    end

    if IsStuck and SelectedPlayer and SelectedPlayer.Character then
        local tgtHRP, tgtHead = SelectedPlayer.Character:FindFirstChild("HumanoidRootPart"), SelectedPlayer.Character:FindFirstChild("Head")
        if hrp and tgtHRP then hrp.CFrame = tgtHRP.CFrame * CFrame.new(0, 0, 2.5) end
        if tgtHead then Cam.CFrame = CFrame.lookAt(Cam.CFrame.Position, tgtHead.Position) end
    elseif S.Aimbot then
        if CurrentAimTarget and CurrentAimTarget.Parent and CurrentAimTarget.Parent:FindFirstChild("Humanoid") and CurrentAimTarget.Parent.Humanoid.Health > 0 then
            local pos, onScr = Cam:WorldToViewportPoint(CurrentAimTarget.Position)
            if not onScr or (S.FOV and (Vector2.new(pos.X, pos.Y) - Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)).Magnitude > S.Rad) or (S.WallCheck and not IsVisible(CurrentAimTarget)) then CurrentAimTarget = nil end
        else CurrentAimTarget = nil end
        if not CurrentAimTarget then CurrentAimTarget = GetClosestAimbotTarget() end
        if CurrentAimTarget then Cam.CFrame = S.SmoothAim and Cam.CFrame:Lerp(CFrame.lookAt(Cam.CFrame.Position, CurrentAimTarget.Position), math.clamp(S.Smooth / 100, 0.01, 1)) or CFrame.lookAt(Cam.CFrame.Position, CurrentAimTarget.Position) end
    end
end)
