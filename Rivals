local function AttachInfo(parentFrame, infoString, layoutOrderNum, btnPos)
    local InfoBtn = c("TextButton", {Size = UDim2.new(0, 24, 0, 24), AnchorPoint = Vector2.new(1, 0.5), Position = btnPos, BackgroundColor3 = Color3.fromRGB(35, 38, 50), Text = "?", TextColor3 = ACCENT_GLOW, Font = Enum.Font.GothamBlack, TextSize = 12, Parent = parentFrame, AutoButtonColor = false})
    corner(InfoBtn, 12); stroke(InfoBtn, Color3.fromRGB(70, 75, 90))
    
    local InfoTxt = c("TextLabel", {Size = UDim2.new(1, 0, 0, 22), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = layoutOrderNum, BackgroundColor3 = Color3.fromRGB(30, 25, 35), Text = "💡 " .. infoString, TextColor3 = Color3.fromRGB(255, 210, 120), Font = Enum.Font.GothamMedium, TextSize = 14, TextWrapped = true, Visible = false, BackgroundTransparency = 1, TextTransparency = 1, Parent = Content})
    corner(InfoTxt, 8); stroke(InfoTxt, Color3.fromRGB(255, 120, 60), 1)
    c("UIPadding", {PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = InfoTxt})
    
    local InfoStroke = InfoTxt:FindFirstChildOfClass("UIStroke"); if InfoStroke then InfoStroke.Transparency = 1 end
    
    InfoBtn.MouseButton1Click:Connect(function()
        tw(InfoBtn, {Size = UDim2.new(0, 20, 0, 20)}, 0.1); task.wait(0.1); tw(InfoBtn, {Size = UDim2.new(0, 24, 0, 24)}, 0.2, Enum.EasingStyle.Bounce)
        InfoTxt.Visible = true; tw(InfoTxt, {BackgroundTransparency = 0.1, TextTransparency = 0}, 0.3)
        if InfoStroke then tw(InfoStroke, {Transparency = 0.1}, 0.3) end
        local clickTime = tick(); InfoTxt:SetAttribute("LastToggled", clickTime)
        task.delay(10, function()
            if InfoTxt:GetAttribute("LastToggled") == clickTime and InfoTxt.Visible then
                tw(InfoTxt, {BackgroundTransparency = 1, TextTransparency = 1}, 0.5); if InfoStroke then tw(InfoStroke, {Transparency = 1}, 0.5) end
                task.wait(0.5); if InfoTxt:GetAttribute("LastToggled") == clickTime then InfoTxt.Visible = false end
            end
        end)
    end)
end

