local function DoUnstick()
    if IsStuck and P.Character and P.Character:FindFirstChild("HumanoidRootPart") then P.Character.HumanoidRootPart.Anchored = false; if SavedPosition then P.Character.HumanoidRootPart.CFrame = SavedPosition end end
    IsStuck = false; SavedPosition = nil; StatusLbl.Text = SelectedPlayer and ("Target: " .. SelectedPlayer.DisplayName) or "Status: Idle"
    Notify("Unstuck", "Target lock released safely.", Color3.fromRGB(255, 100, 100))
end

StickBtn.MouseButton1Click:Connect(function()
    tw(StickBg, {Size = UDim2.new(0.36, 0, 0.9, 0)}, 0.1); task.wait(0.1); tw(StickBg, {Size = UDim2.new(0.40, 0, 1, 0)}, 0.2, Enum.EasingStyle.Bounce)
    if not SelectedPlayer then Notify("Action Failed", "Please select a target from the radar list first!", Color3.fromRGB(255, 60, 60)); return end
    if not IsStuck and P.Character and P.Character:FindFirstChild("HumanoidRootPart") then SavedPosition = P.Character.HumanoidRootPart.CFrame; P.Character.HumanoidRootPart.Anchored = true end
    IsStuck = true; StatusLbl.Text = "🔒 LOCKED: " .. SelectedPlayer.DisplayName
